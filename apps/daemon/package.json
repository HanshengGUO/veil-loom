{
  "name": "@veilquant/loom-daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local process and session daemon for Veil Loom",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "cross-env LOOM_DEMO_SESSION=1 tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@hono/node-server": "2.1.1",
    "@veilquant/loom-protocol": "0.0.0",
    "hono": "4.13.2",
    "tsx": "4.23.12",
    "veil-quant": "0.1.0"
  },
  "devDependencies": {
    "cross-env": "10.1.0"
  }
}
